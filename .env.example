# =====================================================================
# Variables de entorno — Semana de Talleres
# =====================================================================
# 1. Copiá este archivo a .env.local:
#      cp .env.example .env.local
# 2. Completá con los valores de tu proyecto Supabase (Dashboard > Settings > API).
# 3. Reiniciá el server de desarrollo.
# =====================================================================

# --- Cliente (públicas, visibles en el navegador) ---
# Project URL. Ej: https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon public key (clave pública, no es secreta). Sirve con RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Servidor (SECRETA, NUNCA exponer en el navegador) ---
# Service Role key. Saltea RLS. Usada solo en route handlers de exportación
# y operaciones admin en el servidor. NO la pongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
