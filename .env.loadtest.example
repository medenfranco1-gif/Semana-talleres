# =====================================================================
# Variables de entorno para PRUEBAS DE CARGA
# =====================================================================
# NO SUBIR A GIT
# Este archivo contiene las credenciales del Supabase de PRUEBA
# =====================================================================

# --- Supabase de PRUEBA (Semana-Talleres-Prueba-400) ---
# IMPORTANTE: Estos valores deben apuntar SOLO al proyecto de prueba
# NUNCA a producción

# Project URL del Supabase de PRUEBA
# Ejemplo: https://abcd1234xyz.supabase.co
TEST_SUPABASE_URL=

# Anon key del Supabase de PRUEBA (clave pública)
# Desde: Supabase Dashboard > Settings > API > Project API keys > anon public
TEST_SUPABASE_ANON_KEY=

# Service Role Key del Supabase de PRUEBA (clave secreta con permisos admin)
# Desde: Supabase Dashboard > Settings > API > Project API keys > service_role secret
# ADVERTENCIA: Esta clave tiene permisos totales - SOLO para testing, NUNCA en producción
TEST_SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación local ---
# URL donde corre Next.js localmente
BASE_URL=http://localhost:3000

# --- Configuración de pruebas ---
# Cantidad de usuarios simultáneos (default: 5)
CONCURRENCY=5

# Nombre del taller para probar inscripción
# Debe existir en el catálogo del Supabase de prueba
TALLER_NOMBRE=

# Opcional: ID específico del taller (en lugar de nombre)
TALLER_ID=
